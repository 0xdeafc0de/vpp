#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)

if docker compose version >/dev/null 2>&1; then
  compose=(docker compose -f "${repo_root}/compose.dev.yaml")
  compose_legacy=0
elif command -v docker-compose >/dev/null 2>&1; then
  compose=(docker-compose -f "${repo_root}/compose.dev.yaml")
  compose_legacy=1
else
  echo "Neither 'docker compose' nor 'docker-compose' is available." >&2
  echo "Install the Docker Compose plugin or docker-compose and try again." >&2
  exit 1
fi

service=vpp-dev

usage() {
  cat <<'EOF'
Usage:
  docker/dev/vpp-dev up
  docker/dev/vpp-dev shell
  docker/dev/vpp-dev build [make-args...]
  docker/dev/vpp-dev build-release [make-args...]
  docker/dev/vpp-dev test [make-args...]
  docker/dev/vpp-dev run [startup.conf] [make-args...]
  docker/dev/vpp-dev run-debug [startup.conf] [make-args...]
  docker/dev/vpp-dev down
EOF
}

require_running() {
  "${compose[@]}" up -d "${service}" >/dev/null
}

cmd=${1:-}
if [ -z "${cmd}" ]; then
  usage
  exit 1
fi
shift

case "${cmd}" in
  up)
    if [ "${compose_legacy}" -eq 1 ]; then
      docker rm -f "${service}" >/dev/null 2>&1 || true
      "${compose[@]}" up -d --build "${service}"
    else
      "${compose[@]}" up -d --build --force-recreate "${service}"
    fi
    ;;
  shell)
    require_running
    "${compose[@]}" exec "${service}" bash
    ;;
  build)
    require_running
    "${compose[@]}" exec "${service}" make build "$@"
    ;;
  build-release)
    require_running
    "${compose[@]}" exec "${service}" make build-release "$@"
    ;;
  test)
    require_running
    "${compose[@]}" exec "${service}" make test "$@"
    ;;
  run)
    require_running
    startup_conf=${1:-/workspace/vpp/docker/dev/startup.conf}
    if [ "$#" -gt 0 ]; then
      shift
    fi
    "${compose[@]}" exec "${service}" make run-release STARTUP_CONF="${startup_conf}" "$@"
    ;;
  run-debug)
    require_running
    startup_conf=${1:-/workspace/vpp/docker/dev/startup.conf}
    if [ "$#" -gt 0 ]; then
      shift
    fi
    "${compose[@]}" exec "${service}" make run STARTUP_CONF="${startup_conf}" "$@"
    ;;
  down)
    "${compose[@]}" down
    ;;
  *)
    usage
    exit 1
    ;;
esac
